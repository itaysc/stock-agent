# Copy to .env (git-ignored). The app calls /api on its own site; API_URL is where that goes:
# locally the dev server forwards it there, and `npm run build` writes Netlify's _redirects with it
# (on Netlify, set API_URL in Site settings → Environment variables).
# Local server: http://127.0.0.1:3000 (also the default when unset).
API_URL=https://stock-agent-production-78cb.up.railway.app
# Optional, local dev only: the server's API_TOKEN, added by the dev proxy (or just log in).
# API_TOKEN=
