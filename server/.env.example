NODE_ENV=development
# 127.0.0.1 = only this machine can reach the server (no login yet); 0.0.0.0 exposes it
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated; leave empty to disable CORS
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# MongoDB (local: `npm run db:up` starts it on port 27018)
MONGODB_URI=mongodb://localhost:27018/stock-invest

# Every request except GET /health needs "Authorization: Bearer <API_TOKEN>" (or x-api-key).
# Leave empty locally. Required on Railway (the server refuses to start without it): openssl rand -hex 32
API_TOKEN=

# Alpaca: https://app.alpaca.markets -> API Keys. Paper and live accounts have separate keys.
# "Key" from the dashboard (PK... for paper, AK... for live)
ALPACA_API_KEY=
# "Secret" from the dashboard, shown only once when the key is generated
ALPACA_API_SECRET=
# The endpoint is picked from this flag, no need to set it:
#   true  -> https://paper-api.alpaca.markets (paper trading)
#   false -> https://api.alpaca.markets (LIVE trading with real money)
ALPACA_PAPER=true
# iex (free) | sip (paid data subscription)
ALPACA_DATA_FEED=iex
# Real-time streams (order updates + market data). Alpaca allows one market data
# connection per account, so set false on any extra instance.
ALPACA_STREAMS_ENABLED=true

# Risk limits (USD). Checked before every order that adds risk; sells that
# reduce a position are always allowed. Kill switch: `npm run kill-switch`.
RISK_MAX_POSITION_VALUE=10000
RISK_MAX_TOTAL_EXPOSURE=50000
RISK_MAX_DAILY_LOSS=1000
RISK_MAX_ORDERS_PER_MINUTE=10

# Strategies the server runs live (JSON array). Empty = none. Example:
# LIVE_STRATEGIES=[{"strategy":"sma-crossover","symbols":["AAPL"],"timeframe":"15Min","params":{"fast":"10","slow":"30"}}]
LIVE_STRATEGIES=[]
# Strategies never run on a live (real money) account unless this is true.
STRATEGIES_ALLOW_LIVE=false

# Paper deployments: daily strategies on the paper account (Lab → Paper trading).
# The runner checks for completed daily bars and fills every N minutes.
PAPER_TRADING_ENABLED=true
PAPER_TRADING_POLL_MINUTES=15

# Autopilot (turned on/off and configured in the Lab → Paper trading → Autopilot).
AUTOPILOT_SCHEDULER_ENABLED=true
# Optional: earnings dates and surprises for the earnings blocks (free key: https://www.alphavantage.co/support/#api-key).
ALPHAVANTAGE_API_KEY=

# Optional: SEC EDGAR filings in the real-time news check. The SEC asks for a contact here,
# e.g. SEC_USER_AGENT="stock-invest you@example.com". Empty = the filings check is off.
SEC_USER_AGENT=

# Optional: Telegram notifications (autopilot decisions, breaking news on holdings).
# Create a bot with @BotFather, send it a message, then get the chat id (see the README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Read your replies there: Invest/Skip buttons and commands (/help). false = send only.
TELEGRAM_COMMANDS_ENABLED=true

# Optional: every autopilot decision is POSTed here as {"text": "..."} (e.g. a Slack incoming webhook).
NOTIFY_WEBHOOK_URL=

# OpenAI: AI summary + research recommendation for each backtest / sweep.
# Leave empty to turn summaries off. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# gpt-5.6-luna: low-cost tier of OpenAI's newest family ($0.20 / $1.20 per 1M tokens)
OPENAI_MODEL=gpt-5.6-luna
