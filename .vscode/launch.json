{
  "version": "0.2.0",
  "configurations": [
    {
      // Start the server yourself with `npm run start:debug` (in server/), then run this.
      // Port 9229 matches the --debug flag in that script. `restart` re-attaches
      // after every watch-mode rebuild.
      "name": "Attach to server",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/server/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // Starts MongoDB + the server in debug/watch mode and attaches in one step.
      "name": "Debug server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/server/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
